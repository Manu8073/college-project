# NETRA Currency Detection service — environment variables
# Copy this file to .env to change a value. DO NOT commit .env.
# Every variable is optional; the values below are the defaults.

# Predictions below this confidence (0.0 - 1.0) are reported as "not found"
CURRENCY_MIN_CONFIDENCE=0.6

# Browser origins allowed to call this API (comma-separated). Must match the Vite dev URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000

# Load the model when the server starts (recommended). Set to false only for debugging.
PRELOAD_MODEL=true
