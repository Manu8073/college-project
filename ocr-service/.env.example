# NETRA OCR service — environment variables
# Copy this file to .env to change a value.  DO NOT commit .env.
# Every variable is optional; the values below are the defaults.

# OCR language model. "en" = English. Other examples: ch, japan, korean, hi, ta, te
OCR_LANG=en

# Lines the model is less sure about than this (0.0 – 1.0) are dropped from the response.
OCR_MIN_CONFIDENCE=0.5

# Browser origins allowed to call this API (comma-separated). Must match the Vite dev URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000

# Load the OCR model when the server starts (recommended). Set to false only for debugging.
PRELOAD_MODEL=true

# ── PaddleOCR / PaddleX model download settings (optional) ───
# Where to download models from on first start: huggingface (default), bos, modelscope
# PADDLE_PDX_MODEL_SOURCE=huggingface
# Skip the connectivity check on start-up (saves a few seconds)
# PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
